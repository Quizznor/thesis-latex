@article{
  title = {Extremely Efficient {{Zevatron}} in Rotating {{AGN}} Magnetospheres},
  author = {Osmanov, Z. and Mahajan, S. and Machabeli, G. and Chkheidze, N.},
  date = {2014-12-21},
  journaltitle = {Mon Not R Astron Soc},
  volume = {445},
  number = {4},
  pages = {4155--4160},
  issn = {0035-8711},
  doi = {10.1093/mnras/stu2042},
  url = {https://doi.org/10.1093/mnras/stu2042},
  urldate = {2025-08-10},
  abstract = {A novel model of particle acceleration in the magnetospheres of rotating active galactic nuclei (AGN) is constructed. The particle energies may be boosted up to 1021~eV in a two-step mechanism: in the first stage, the Langmuir waves are centrifugally excited and amplified by means of a parametric process that efficiently pumps rotational energy to excite electrostatic fields. In the second stage, the electrostatic energy is transferred to particle kinetic energy via Landau damping made possible by rapid ‘Langmuir collapse’. The time-scale for parametric pumping of Langmuir waves turns out to be small compared to the kinematic time-scale, indicating high efficiency of the first process. The second process of ‘Langmuir collapse’ – the creation of caverns or low-density regions – also happens rapidly for the characteristic parameters of the AGN magnetosphere. The Langmuir collapse creates appropriate conditions for transferring electric energy to boost up already high particle energies to much higher values. It is further shown that various energy loss mechanism are relatively weak, and do not impose any significant constraints on maximum achievable energies.},
  keywords = {phys},
  file = {/home/filip/Zotero/storage/LXW32I2U/Osmanov et al. - 2014 - Extremely efficient Zevatron in rotating AGN magnetospheres.pdf;/home/filip/Zotero/storage/9RJKVQ2E/stu2042.html}
}

@article{
  title = {Monte {{Carlo}} Treatment of Hadronic Interactions in Enhanced {{Pomeron}} Scheme: {{I}}. {{QGSJET-II}} Model},
  shorttitle = {Monte {{Carlo}} Treatment of Hadronic Interactions in Enhanced {{Pomeron}} Scheme},
  author = {Ostapchenko, Sergey},
  date = {2011-01-25},
  journaltitle = {Phys. Rev. D},
  volume = {83},
  number = {1},
  eprint = {1010.1869},
  eprinttype = {arXiv},
  eprintclass = {hep-ph},
  pages = {014018},
  issn = {1550-7998, 1550-2368},
  doi = {10.1103/PhysRevD.83.014018},
  url = {http://arxiv.org/abs/1010.1869},
  urldate = {2025-09-17},
  abstract = {The construction of a Monte Carlo generator for high energy hadronic and nuclear collisions is discussed in detail. Interactions are treated in the framework of the Reggeon Field Theory, taking into consideration enhanced Pomeron diagrams which are resummed to all orders in the triple-Pomeron coupling. Soft and "semihard" contributions to the underlying parton dynamics are accounted for within the "semihard Pomeron" approach. The structure of cut enhanced diagrams is analyzed; they are regrouped into a number of subclasses characterized by positively defined contributions which define partial weights for various "macro-configurations" of hadronic final states. An iterative procedure for a Monte Carlo generation of the structure of final states is described. The model results for hadronic cross sections and for particle production are compared to experimental data.},
