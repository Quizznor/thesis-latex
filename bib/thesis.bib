@thesis{
  type = {Disertační práce},
  title = {Vývoj Kalibračního Světelného Zdroje pro Fluorescenční Detektor {{Observatoře Pierra Augera}}},
  author = {Vacula, Martin},
  date = {2024},
  institution = {Univerzita Palackého v Olomouci, Přírodovědecká fakulta},
  url = {https://theses.cz/id/elli15/?isshlret=Martin%3BVACULA%3B;zpet=%2Fvyhledavani%2F%3Fsearch%3Dmartin%20vacula%26start%3D1},
  urldate = {2025-10-20},
  abstract = {An absolute end-to-end calibration of the fluorescence detector is a key to set the energy scale of the Pierre Auger Observatory. To do so, a precisely characterized calibration light source has to be employed. However, there are specific demands on its size, weight, mechanical durability, and especially the optical properties. The goal of the thesis is to develop and characterize a calibration light source that meets all the requirements to perform the absolute calibration. During the development process, a numerous laboratory measurements and time consuming optical ray-tracing simulations are performed in order to achieve the desired performance of the calibration light source. Along the way, the calibration light source is described in detail and characterized by further laboratory measurements. Within the thesis, its final design is shown and its optical properties are presented and thoroughly discussed.},
  langid = {english},
  keywords = {phys},
  file = {/home/filip/Zotero/storage/D4NVDRXX/elli15.html}
}

@article{
  title = {Detecting the {{Largest Magnets}}: {{The Universe}} and the {{Clusters}} of {{Galaxies}}},
  shorttitle = {Detecting the {{Largest Magnets}}},
  author = {Vallee, J. P.},
  date = {1990-09-01},
  journaltitle = {The Astrophysical Journal},
  volume = {360},
  pages = {1},
  issn = {0004-637X},
  doi = {10.1086/169089},
  url = {https://ui.adsabs.harvard.edu/abs/1990ApJ...360....1V},
  urldate = {2025-09-05},
  abstract = {Recently, a large sample of rotation measures of galaxies and quasars at various redshifts has been published. This data set has been employed so far for detecting a magnetic field component of about 1.5 μG in the Virgo Supercluster and for placing an upper limit of 0.1 μG for a magnetic field in the Great Attractor Supercluster. Here this data set will be used to test for the existence of an uniform component of a cosmic/intergalactic magnetic field outside clusters of galaxies. From a total of 309 galaxies and quasars with a known redshift and a small intrinsic rotation measure value, an upper limit of about 2 rad m\textasciicircum -2\textasciicircum{} is obtained for such a cosmic/intergalactic contribution out to a redshift z of 3.6. From this result, and a mean density of 10\textasciicircum -5\textasciicircum{} cm\textasciicircum -3\textasciicircum, an upper limit of 6 x 10\textasciicircum -12\textasciicircum{} G follows for the strength of such a cosmic/intergalactic magnetic field outside clusters of galaxies, or an upper limit of 6 x 10\textasciicircum -11\textasciicircum{} G for a mean density of 10\textasciicircum -6\textasciicircum{} cm\textasciicircum -3\textasciicircum.},
  keywords = {Astrophysics,COSMOLOGY,Dynamo Theory,Galactic Clusters,Galactic Evolution,Galactic Rotation,GALAXIES: CLUSTERING,GALAXIES: INTERGALACTIC MEDIUM,Intergalactic Media,Interstellar Magnetic Fields,MAGNETIC FIELDS,Magnetic Flux,phys,Quasars,Sky Surveys (Astronomy),Spiral Galaxies},
  annotation = {ADS Bibcode: 1990ApJ...360....1V},
  file = {/home/filip/Zotero/storage/ZULDZUHP/Vallee - 1990 - Detecting the Largest Magnets The Universe and the Clusters of Galaxies.pdf}
}

