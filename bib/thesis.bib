@article{
  title = {An {{Upper Limit}} on the {{Strength}} of the {{Extragalactic Magnetic Field}} from {{Ultra-high-energy Cosmic-Ray Anisotropy}}},
  author = {Bray, J. D. and Scaife, A. M. M.},
  date = {2018-06},
