  journaltitle = {The Astrophysical Journal},
  volume = {610},
  pages = {820--826},
  issn = {0004-637X},
  doi = {10.1086/421760},
  url = {https://ui.adsabs.harvard.edu/abs/2004ApJ...610..820H},
  urldate = {2025-09-05},
  abstract = {Interstellar magnetic fields exist over a broad range of spatial scales, extending from large Galactic scales (\textasciitilde 10 kpc) down to very small dissipative scales ({$<<$}1 pc). In this paper, we use a set of 490 pulsars distributed over roughly one-third of the Galactic disk out to a radius R\textasciitilde =10 kpc (assuming Rsolar=8.5 kpc) and combine their observed rotation and dispersion measures with their estimated distances to derive the spatial energy spectrum of the Galactic interstellar magnetic field over the scale range 0.5-15 kpc. We obtain a nearly flat spectrum, with a one-dimensional power-law index α=-0.37+/-0.10 for EB(k)=Ckα and an rms field strength of approximately 6 μG over the relevant scales. Our study complements the derivation of the magnetic energy spectrum over the scale range 0.03-100 pc by Minter \& Spangler, showing that the magnetic spectrum becomes flatter at larger scales. This observational result is discussed in the framework of current theoretical and numerical models.},
  keywords = {Astrophysics,ISM: Magnetic Fields,phys,Stars: Pulsars: General,Turbulence},
  annotation = {ADS Bibcode: 2004ApJ...610..820H},
  file = {/home/filip/Zotero/storage/XYEU2XZU/Han et al. - 2004 - The Spatial Energy Spectrum of Magnetic Fields in Our Galaxy.pdf}
