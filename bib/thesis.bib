@article{
  title = {The Offline Software Framework of the {{Pierre Auger Observatory}}},
  author = {Argirò, S. and Barroso, S. L. C. and Gonzalez, J. and Nellen, L. and Paul, T. and Porter, T. A. and Prado Jr., L. and Roth, M. and Ulrich, R. and Veberič, D.},
