@article{
  title = {The {{Origin}} of {{Kepler}}'s {{Supernova Remnant}}},
  author = {Patnaude, Daniel J. and Badenes, Carles and Park, Sangwook and Laming, J. Martin},
  date = {2012},
  publisher = {arXiv},
  doi = {10.48550/ARXIV.1206.6799},
  url = {https://arxiv.org/abs/1206.6799},
  urldate = {2025-08-13},
  abstract = {It is now well established that Kepler's supernova remnant is the result of a Type Ia explosion. With an age of 407 years, and an angular diameter of \textasciitilde{} 4', Kepler is estimated to be between 3.0 and 7.0 kpc distant. Unlike other Galactic Type Ia supernova remnants such as Tycho and SN 1006, and SNR 0509-67.5 in the Large Magellanic Cloud, Kepler shows evidence for a strong circumstellar interaction. A bowshock structure in the north is thought to originate from the motion of a mass-losing system through the interstellar medium prior to the supernova. We present results of hydrodynamical and spectral modeling aimed at constraining the circumstellar environment of the system and the amount of 56Ni produced in the explosion. Using models that contain either 0.3 M\_sun (subenergetic) or 1 M\_sun (energetic) of 56Ni, we simulate the interaction between supernova Ia ejecta and various circumstellar density models. Based on dynamical considerations alone, we find that the subenergetic models favor a distance to the SNR of \&lt; 6.4 kpc, while the model that produces 1 M\_sun of 56Ni requires a distance to the SNR of \&gt; 7 kpc. The X-ray spectrum is consistent with an explosion that produced \textasciitilde{} 1 M\_sun of 56Ni, ruling out the subenergetic models, and suggesting that Kepler's SNR was a SN 1991T-like event. Additionally, the X-ray spectrum rules out a pure 1/r\textasciicircum 2 wind profile expected from isotropic mass loss up to the time of the supernova. Introducing a small cavity around the progenitor system results in modeled X-ray spectra that are consistent with the observed spectrum. If a wind shaped circumstellar environment is necessary to explain the dynamics and X-ray emission from the shocked ejecta in Kepler's SNR, then we require that the distance to the remnant be greater than 7 kpc.},
  version = {1},
  keywords = {FOS: Physical sciences,High Energy Astrophysical Phenomena (astro-ph.HE)}
}

