@incollection{
  title = {The {{AMIGA}} Underground Muon Detector of the {{Pierre Auger Observatory}} - Performance and Event Reconstruction},
  booktitle = {Proceedings of 36th {{International Cosmic Ray Conference}} — {{PoS}}({{ICRC2019}})},
  author = {Botti, Ana Martina and family=Pierre Auger Collaboration, prefix=the, useprefix=true},
  date = {2021-07-02},
  volume = {358},
  pages = {202},
  publisher = {SISSA Medialab},
  doi = {10.22323/1.358.0202},
  url = {https://pos.sissa.it/358/202/},
  urldate = {2025-04-26},
  abstract = {The Auger Muons and Infill for the Ground Array (AMIGA) aims to both lower the detection threshold of the Pierre Auger Observatory down to energies of \$\textbackslash sim 10\textasciicircum\{16.5\}\$ eV and to directly measure the muon content of extensive air showers. AMIGA consists of an array of coupled water-Cherenkov and buried scintillation detectors deployed in two superimposed triangular grids of 433 m and 750 m spacings. Each underground detector has a total area of 30 \$\textbackslash mathrm\{m\}\textasciicircum 2\$ buried at a depth of 2.3 m, to shield it from the shower electromagnetic component. The scintillation plane is segmented in plastic-scintillator strips with embedded wavelength-shifter optical fibers coupled to a common optical sensor. Before proceeding to the construction of the full-size array, an engineering array was operated until November 2017 to validate and optimize the design, and to evaluate the performance of the detection system. During this phase, scintillation areas of 5 \$\textbackslash mathrm\{m\}\textasciicircum 2\$ and 10 \$\textbackslash mathrm\{m\}\textasciicircum 2\$ and two optical sensors, photomultiplier tubes and silicon photomultipliers, were tested. In this work, we present the status and performance of the array currently equipped with silicon photomultipliers, along with the timing performance and geometry reconstruction of modules equipped with photomultiplier tubes. Analyses and results are based on both laboratory and field measurements. Scintillation areas of 10 \$\textbackslash mathrm\{m\}\textasciicircum 2\$ and silicon photomultipliers as readout have been selected as the baseline design for the full-scale AMIGA array.},
  eventtitle = {36th {{International Cosmic Ray Conference}}},
  langid = {english},
  keywords = {phys},
  file = {/home/filip/Zotero/storage/RDGH7YEA/Botti and on behalf of the Pierre Auger Collaboration - 2021 - The AMIGA underground muon detector of the Pierre Auger Observatory - performance and event reconstr.pdf}
}

